# Shattered SMP API — environment
# Copy to .env (VPS) or set in the Render dashboard.

# PostgreSQL connection string.
# Render: from your Render PostgreSQL instance (internal connection string).
# VPS: postgres://user:password@127.0.0.1:5432/shattered_smp
DATABASE_URL=

# Three SEPARATE secrets — each component only knows its own.
# Generate each with:  openssl rand -hex 32
# The Minecraft plugin config must match PLUGIN_SHARED_SECRET.
PLUGIN_SHARED_SECRET=
# The website must match INTERNAL_SECRET.
INTERNAL_SECRET=
# The Discord bot must match BOT_SECRET.
BOT_SECRET=

# Port the API listens on (Render sets this automatically).
PORT=4000

# Shown in status responses / health check.
NEXT_PUBLIC_SITE_NAME=Shattered SMP

# Shared secret between this API and the website (site sends it as Bearer).
SITE_API_KEY=change-me-32-hex
# Assistant name shown by the website chat bubble.
ASSISTANT_NAME=Shard
